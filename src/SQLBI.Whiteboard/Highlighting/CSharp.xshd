<?xml version="1.0" encoding="utf-8"?>
<!--
  C#. A color name here is a category, not a color: SyntaxHighlighter maps the
  names to the palette every language shares.

  A raw string's delimiter is counted by the language and cannot be counted by a
  regex, so the three, four and five quote forms have a rule each, longest
  first. Six or more quotes, which no real snippet uses, reads as the three.
-->
<SyntaxDefinition name="C#" extensions=".cs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" />
  <Color name="String" />
  <Color name="Character" />
  <Color name="Interpolation" />
  <Color name="Number" />
  <Color name="Keyword" />
  <Color name="TypeKeyword" />
  <Color name="Preprocessor" />
  <Color name="Attribute" />
  <Color name="Function" />
  <Color name="Operator" />
  <Color name="Punctuation" />

  <RuleSet ignoreCase="false">
    <Span color="Preprocessor">
      <Begin>\#(?=[A-Za-z])</Begin>
    </Span>

    <Span color="Comment" multiline="true"><Begin>/\*</Begin><End>\*/</End></Span>
    <Span color="Comment"><Begin>//</Begin></Span>

    <!-- Raw strings, longest delimiter first, with any number of $ before them. -->
    <Span color="String" multiline="true">
      <Begin>\$*"""""(?!")</Begin>
      <End>"""""</End>
    </Span>
    <Span color="String" multiline="true">
      <Begin>\$*""""(?!")</Begin>
      <End>""""</End>
    </Span>
    <Span color="String" multiline="true">
      <Begin>\$*"""(?!")</Begin>
      <End>"""</End>
    </Span>

    <!-- Verbatim, and verbatim interpolated: a doubled quote is an escape, and
         the string runs on until a quote that is not one. -->
    <Span color="String" multiline="true">
      <Begin>(@\$?|\$@)"</Begin>
      <End>"(?!")</End>
      <RuleSet>
        <Span begin='""' end="" />
        <Span begin="\{\{" end="" />
        <Span color="Interpolation" ruleSet="" begin="\{" end="\}" />
      </RuleSet>
    </Span>

    <Span color="String">
      <Begin>\$"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
        <Span begin="\{\{" end="" />
        <Span color="Interpolation" ruleSet="" begin="\{" end="\}" />
      </RuleSet>
    </Span>

    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Span color="Character">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>

    <!-- An attribute list, which starts its own line; a subscript does not. -->
    <Span color="Attribute">
      <Begin>^\s*\[(?=\s*[A-Za-z_])</Begin>
      <End>\]</End>
      <RuleSet>
        <Span color="String"><Begin>"</Begin><End>"</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>
        <Rule color="Number">\b\d[\d_]*\b</Rule>
      </RuleSet>
    </Span>

    <!-- A verbatim identifier is a name, whatever it spells. -->
    <Rule>@[A-Za-z_]\w*</Rule>

    <Keywords color="Keyword">
      <Word>abstract</Word><Word>add</Word><Word>alias</Word><Word>and</Word>
      <Word>as</Word><Word>ascending</Word><Word>async</Word><Word>await</Word>
      <Word>base</Word><Word>break</Word><Word>by</Word><Word>case</Word>
      <Word>catch</Word><Word>checked</Word><Word>class</Word><Word>const</Word>
      <Word>continue</Word><Word>default</Word><Word>delegate</Word><Word>descending</Word>
      <Word>do</Word><Word>else</Word><Word>enum</Word><Word>equals</Word>
      <Word>event</Word><Word>explicit</Word><Word>extern</Word><Word>false</Word>
      <Word>file</Word><Word>finally</Word><Word>fixed</Word><Word>for</Word>
      <Word>foreach</Word><Word>from</Word><Word>get</Word><Word>global</Word>
      <Word>goto</Word><Word>group</Word><Word>if</Word><Word>implicit</Word>
      <Word>in</Word><Word>init</Word><Word>interface</Word><Word>internal</Word>
      <Word>into</Word><Word>is</Word><Word>join</Word><Word>let</Word>
      <Word>lock</Word><Word>nameof</Word><Word>namespace</Word><Word>new</Word>
      <Word>not</Word><Word>notnull</Word><Word>null</Word><Word>on</Word>
      <Word>operator</Word><Word>or</Word><Word>orderby</Word><Word>out</Word>
      <Word>override</Word><Word>params</Word><Word>partial</Word><Word>private</Word>
      <Word>protected</Word><Word>public</Word><Word>readonly</Word><Word>record</Word>
      <Word>ref</Word><Word>remove</Word><Word>required</Word><Word>return</Word>
      <Word>scoped</Word><Word>sealed</Word><Word>select</Word><Word>set</Word>
      <Word>sizeof</Word><Word>stackalloc</Word><Word>static</Word><Word>struct</Word>
      <Word>switch</Word><Word>this</Word><Word>throw</Word><Word>true</Word>
      <Word>try</Word><Word>typeof</Word><Word>unchecked</Word><Word>unsafe</Word>
      <Word>using</Word><Word>value</Word><Word>virtual</Word><Word>volatile</Word>
      <Word>when</Word><Word>where</Word><Word>while</Word><Word>with</Word>
      <Word>yield</Word>
    </Keywords>

    <Keywords color="TypeKeyword">
      <Word>bool</Word><Word>byte</Word><Word>char</Word><Word>decimal</Word>
      <Word>double</Word><Word>dynamic</Word><Word>float</Word><Word>int</Word>
      <Word>long</Word><Word>nint</Word><Word>nuint</Word><Word>object</Word>
      <Word>sbyte</Word><Word>short</Word><Word>string</Word><Word>uint</Word>
      <Word>ulong</Word><Word>ushort</Word><Word>var</Word><Word>void</Word>
    </Keywords>

    <Rule color="Number">
      \b(
        0[xX][0-9a-fA-F_]+
      | 0[bB][01_]+
      | (\d[\d_]*)?\.\d[\d_]*([eE][+-]?\d+)?
      | \d[\d_]*\.?([eE][+-]?\d+)?
      )[uUlLfFdDmM]*
    </Rule>

    <Rule color="Function">
      \b[A-Za-z_]\w* (?= \s* ( \( | &lt; [\w.,\s?\[\]]+ &gt; \s* \( ) )
    </Rule>
    <Rule color="Operator">=&gt;|\?\?=?|[+\-*/%=!&lt;&gt;&amp;|^~?:]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,.]</Rule>
  </RuleSet>
</SyntaxDefinition>
