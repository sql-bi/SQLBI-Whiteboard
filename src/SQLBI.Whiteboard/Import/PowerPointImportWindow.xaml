<Window x:Class="SQLBI.Whiteboard.Import.PowerPointImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import PowerPoint"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ToolbarBackgroundBrush}"
        Stylus.IsPressAndHoldEnabled="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ImportLabel"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="Margin"
                    Value="0,12,0,3" />
        </Style>
        <Style x:Key="ImportHint"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="11.5" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsHintBrush}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
        <Style x:Key="ImportSwitchLabel"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20">
        <TextBlock x:Name="DeckName"
                   FontFamily="Segoe UI"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SettingsTextBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="DeckFacts"
                   Style="{StaticResource ImportHint}"
                   Margin="0,3,0,0"
                   Text="Opening it in PowerPoint" />

        <StackPanel x:Name="Options"
                    IsEnabled="False">
            <TextBlock Style="{StaticResource ImportLabel}"
                       Text="Pictures" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PicturesCombo"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SettingsComboBox}"
                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                          SelectionChanged="PicturesCombo_SelectionChanged" />
                <ComboBox x:Name="ResolutionCombo"
                          Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SettingsComboBox}"
                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                          ToolTip="How many pixels across a slide that comes in as PNG" />
            </Grid>
            <TextBlock x:Name="PicturesHint"
                       Style="{StaticResource ImportHint}"
                       Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource ImportLabel}"
                       Text="Layout" />
            <ComboBox x:Name="LayoutCombo"
                      Width="240"
                      HorizontalAlignment="Left"
                      Style="{StaticResource SettingsComboBox}"
                      ItemContainerStyle="{StaticResource SettingsComboBoxItem}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ImportSwitchLabel}"
                           Text="A frame around each slide" />
                <ToggleButton x:Name="FramesSwitch"
                              Grid.Column="1"
                              Style="{StaticResource SettingsSwitch}" />
            </Grid>
            <Grid x:Name="HiddenRow"
                  Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HiddenLabel"
                           Style="{StaticResource ImportSwitchLabel}"
                           Text="Include hidden slides" />
                <ToggleButton x:Name="HiddenSwitch"
                              Grid.Column="1"
                              Style="{StaticResource SettingsSwitch}" />
            </Grid>
        </StackPanel>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Summary"
                           Style="{StaticResource ImportHint}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           FontSize="12.5" />
                <ProgressBar x:Name="Progress"
                             Height="6"
                             Margin="0,6,20,0"
                             Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="ImportButton"
                    Grid.Column="1"
                    Width="100"
                    Height="32"
                    Margin="12,0,0,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Content="Import"
                    Click="ImportButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Width="88"
                    Height="32"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Content="Cancel"
                    Click="CancelButton_Click" />
        </Grid>
    </StackPanel>
</Window>
