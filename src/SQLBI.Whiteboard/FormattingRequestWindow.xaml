<Window x:Class="SQLBI.Whiteboard.FormattingRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ToolbarBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="Heading"
                   FontFamily="Segoe UI"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FF1F2937"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="Body"
                   Margin="0,12,0,0"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   Foreground="#FF374151"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,16,0,0"
                   FontFamily="Segoe UI"
                   FontSize="13">
            <Hyperlink x:Name="VoteLink"
                       RequestNavigate="VoteLink_RequestNavigate">
                Vote on GitHub
            </Hyperlink>
        </TextBlock>
        <TextBlock x:Name="BrowserFailedText"
                   Margin="0,16,0,0"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   Foreground="#FF374151"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="Windows could not open a browser. Copy the address instead:" />
        <TextBox x:Name="AddressBox"
                 Margin="0,8,0,0"
                 Padding="6,4"
                 FontFamily="Segoe UI"
                 FontSize="13"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />
        <StackPanel Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="96"
                    MinHeight="30"
                    IsDefault="True"
                    IsCancel="True"
                    Content="Close"
                    Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
