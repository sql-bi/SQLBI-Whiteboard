    <Style x:Key="SessionCommandSeparator"
           TargetType="Border">
        <Setter Property="Width"
                Value="1" />
        <Setter Property="Height"
                Value="48" />
        <Setter Property="Margin"
                Value="8,8" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="{StaticResource ToolbarSeparatorBrush}" />
    </Style>

    <Style x:Key="ToolbarIconButton"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Width"
                Value="40" />
        <Setter Property="Height"
                Value="40" />
        <Setter Property="Margin"
                Value="1,0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Foreground"
                Value="{StaticResource ToolbarIconBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarChevronButton"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToolbarIconButton}">
        <Setter Property="Width"
                Value="18" />
        <Setter Property="Margin"
                Value="0,0,2,0" />
        <Setter Property="ToolTip"
                Value="Pen or calligraphy" />
    </Style>

    <!--
        These sizes set the width of the whole tool palette. Six pen swatches drive the shared
        color column, and either dual row - that column plus two tool buttons - is the widest
        thing in the palette. At 32 with a 3 margin the palette overflowed a presenter
        picture-in-picture in the top-right corner, which is the placement the default toolbar
        position exists to hide under. Enlarging these again brings that back.
    -->
    <Style x:Key="ColorSwatchButton"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Width"
                Value="28" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Margin"
                Value="1" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Ellipse x:Name="Ring"
                                 Stroke="Transparent"
                                 StrokeThickness="2" />
                        <!--
                            Inset from 4 to 3 alongside the smaller button, so the visible
                            color only loses 2 units rather than 4.
                        -->
                        <Ellipse Margin="3"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="#33000000"
                                 StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Ring"
                                    Property="Stroke"
                                    Value="#FF2563EB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SizeChipButton"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Width"
                Value="56" />
        <Setter Property="Height"
                Value="40" />
        <Setter Property="Margin"
                Value="2,0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="2">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="#FF2563EB" />
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SessionTabButton"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="MinWidth"
                Value="56" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Foreground"
                Value="{StaticResource ToolbarIconBrush}" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Rectangle x:Name="Underline"
                                       Height="2"
                                       VerticalAlignment="Bottom"
                                       Fill="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Underline"
                                    Property="Fill"
                                    Value="{StaticResource ToolbarAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource ToolbarAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SessionCommandButton"
           TargetType="{x:Type Button}">
        <Setter Property="Width"
                Value="76" />
        <Setter Property="Height"
                Value="64" />
        <Setter Property="Margin"
                Value="2,0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="True" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Foreground"
                Value="{StaticResource ToolbarIconBrush}" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="4,6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource ToolbarAccentBrush}" />
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiveViewOverlayButton"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Stylus.IsPressAndHoldEnabled"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SessionShortcutHint"
           TargetType="TextBlock">
        <Setter Property="Margin"
                Value="0,1,0,0" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="FontSize"
                Value="9" />
        <Setter Property="Foreground"
                Value="#FF9CA3AF" />
    </Style>

</ResourceDictionary>
