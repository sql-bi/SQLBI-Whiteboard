<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- The highlighting adapter runs on AvalonEdit, which is WPF, so these
         tests cannot live in the framework-neutral Core harness. Nothing here
         is published: the pipeline signs and packages the publish output. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>SQLBI.Whiteboard.SmokeTests</AssemblyName>
    <RootNamespace>SQLBI.Whiteboard.SmokeTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SQLBI.Whiteboard\SQLBI.Whiteboard.csproj" />
  </ItemGroup>
</Project>
