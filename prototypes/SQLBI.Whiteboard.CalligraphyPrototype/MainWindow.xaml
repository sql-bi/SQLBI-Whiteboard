<Window x:Class="SQLBI.Whiteboard.CalligraphyPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SQLBI.Whiteboard.CalligraphyPrototype"
        Title="SQLBI Whiteboard — Calligraphy Lab"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="650"
        Background="White"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF374151" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF4B5563" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="TuningSliderStyle" TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="AutoToolTipPlacement" Value="BottomRight" />
            <Setter Property="AutoToolTipPrecision" Value="2" />
            <EventSetter Event="ValueChanged" Handler="TuningSlider_ValueChanged" />
        </Style>
    </Window.Resources>

    <Grid>
        <local:CalligraphyTuningCanvas x:Name="InkSurface"
                                       Background="White"
                                       EditingMode="Ink"
                                       EditingModeInverted="None"
                                       Stylus.IsPressAndHoldEnabled="False"
                                       Stylus.IsFlicksEnabled="False"
                                       PreviewStylusDown="InkSurface_PreviewStylusDown"
                                       PreviewMouseDown="InkSurface_PreviewMouseDown"
                                       PreviewMouseMove="InkSurface_PreviewMouseMove"
                                       PreviewMouseUp="InkSurface_PreviewMouseUp"
                                       PreviewTouchDown="InkSurface_PreviewTouch"
                                       PreviewTouchMove="InkSurface_PreviewTouch"
                                       PreviewTouchUp="InkSurface_PreviewTouch" />

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="420"
                MaxHeight="840"
                Margin="18"
                Padding="16"
                CornerRadius="12"
                Background="#F2FAFAFA"
                BorderBrush="#809CA3AF"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Text="Calligraphy Lab" />
                    <TextBlock Margin="0,4,0,10"
                               Foreground="#FF4B5563"
                               TextWrapping="Wrap"
                               Text="Draw with the pen. Higher pressure exponent makes light pressure thinner; higher speed influence makes fast movement thinner." />

                    <WrapPanel Margin="0,0,0,8">
                        <Button Margin="0,0,6,6"
                                Padding="10,6"
                                Content="Current app"
                                Click="CurrentPresetButton_Click" />
                        <Button Margin="0,0,6,6"
                                Padding="10,6"
                                Content="Stronger preset"
                                Click="StrongerPresetButton_Click" />
                        <Button Margin="0,0,6,6"
                                Padding="10,6"
                                Content="Clear"
                                Click="ClearButton_Click" />
                        <Button Margin="0,0,0,6"
                                Padding="10,6"
                                Content="Copy settings"
                                Click="CopySettingsButton_Click" />
                    </WrapPanel>

                    <Border Padding="10"
                            Background="#FFEFF6FF"
                            CornerRadius="7">
                        <StackPanel>
                            <TextBlock x:Name="MetricsText"
                                       FontFamily="Consolas"
                                       Text="Pressure 0.000 → 0.000   Speed 0.000" />
                            <TextBlock x:Name="PresetText"
                                       Margin="0,3,0,0"
                                       Foreground="#FF4B5563"
                                       Text="Preset: Current app" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Nib" />

                    <DockPanel>
                        <TextBlock Text="Nominal size" />
                        <TextBlock x:Name="NominalSizeValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="NominalSizeSlider" Style="{StaticResource TuningSliderStyle}" Minimum="1" Maximum="14" Value="4" />

                    <DockPanel>
                        <TextBlock Text="Width multiplier" />
                        <TextBlock x:Name="NibWidthValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="NibWidthSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0.5" Maximum="5" Value="3" />

                    <DockPanel>
                        <TextBlock Text="Height multiplier" />
                        <TextBlock x:Name="NibHeightValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="NibHeightSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0.1" Maximum="2" Value="0.65" />

                    <DockPanel>
                        <TextBlock Text="Nib angle" />
                        <TextBlock x:Name="NibAngleValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="NibAngleSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0" Maximum="90" Value="90" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Pressure" />

                    <DockPanel>
                        <TextBlock Text="Pressure exponent" />
                        <TextBlock x:Name="PressureExponentValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="PressureExponentSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0.2" Maximum="3" Value="0.65" />

                    <DockPanel>
                        <TextBlock Text="Pressure influence" />
                        <TextBlock x:Name="PressureInfluenceValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="PressureInfluenceSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0" Maximum="1" Value="1" />

                    <DockPanel>
                        <TextBlock Text="Minimum width" />
                        <TextBlock x:Name="MinimumWidthValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="MinimumWidthSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0" Maximum="0.35" Value="0.04" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Speed" />

                    <DockPanel>
                        <TextBlock Text="Speed influence" />
                        <TextBlock x:Name="SpeedInfluenceValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="SpeedInfluenceSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0" Maximum="1" Value="1" />

                    <DockPanel>
                        <TextBlock Text="Speed reference" />
                        <TextBlock x:Name="SpeedReferenceValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="SpeedReferenceSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0.1" Maximum="8" Value="1.25" />

                    <DockPanel>
                        <TextBlock Text="Speed smoothing" />
                        <TextBlock x:Name="SpeedSmoothingValue" DockPanel.Dock="Right" Style="{StaticResource ValueStyle}" />
                    </DockPanel>
                    <Slider x:Name="SpeedSmoothingSlider" Style="{StaticResource TuningSliderStyle}" Minimum="0" Maximum="0.95" Value="0.65" />

                    <CheckBox x:Name="FitToCurveCheckBox"
                              Margin="0,8,0,2"
                              Content="Use WPF curve fitting"
                              Checked="FitToCurveCheckBox_Changed"
                              Unchecked="FitToCurveCheckBox_Changed" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
