<?xml version="1.0" encoding="UTF-8"?>
<!--
  Builds every installer variant from a single source. Two preprocessor variables
  select the variant:

    -d Channel=stable|dev      released channel, or the pre-release channel
    -d Scope=perMachine|perUser

  Each of the four combinations is a distinct product with its own UpgradeCode, so a
  per-user install never tries to upgrade a per-machine one, and a pre-release install
  sits alongside a released one rather than replacing it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define AppName = "SQLBI Whiteboard" ?>
  <?define AppExecutableName = "SQLBI.Whiteboard.exe" ?>
  <?define AppManufacturer = "SQLBI" ?>
  <?define AppInstallFolder = "SQLBI" ?>
  <?define AppInstallSubfolder = "Whiteboard" ?>
  <?define AppUrlInfoAbout = "https://whiteboard.sqlbi.com" ?>
  <?define BoardExtension = "wboard" ?>
  <?define BoardProgId = "SQLBI.Whiteboard.Board" ?>

  <!--
    The pre-release channel is a separate product: its own UpgradeCodes, name, install
    folder and settings, so a tester can keep a released copy installed alongside it.
    It deliberately does not claim the .wboard file type, which stays with the released
    channel; uninstalling a pre-release therefore cannot break that association.
  -->
  <?if $(var.Channel) = dev ?>
    <?define ChannelName = "Dev" ?>
    <?define ChannelNameSuffix = " (Dev)" ?>
    <?define ChannelFolderSuffix = " Dev" ?>
    <?define RegistersFileType = "no" ?>
    <?if $(var.Scope) = perUser ?>
      <?define UpgradeCodeGuid = "{A23653E1-91B3-4EAA-BA84-3792046F5907}" ?>
    <?else?>
      <?define UpgradeCodeGuid = "{B995F70F-44C0-4BC4-B2B7-3D886C979C6F}" ?>
    <?endif?>
  <?elseif $(var.Channel) = stable ?>
    <?define ChannelNameSuffix = "" ?>
    <?define ChannelFolderSuffix = "" ?>
    <?define RegistersFileType = "yes" ?>
    <?if $(var.Scope) = perUser ?>
      <?define UpgradeCodeGuid = "{F11E7279-D134-4201-AD35-AD49B33B5F6D}" ?>
    <?else?>
      <?define UpgradeCodeGuid = "{E753CDD2-A0A3-45E8-ABFC-5EE1E6B15AAD}" ?>
    <?endif?>
  <?else?>
    <?error Channel must be defined as either stable or dev ?>
  <?endif?>

  <?if $(var.Scope) = perUser ?>
    <?define ProductNameSuffix = "$(var.ChannelNameSuffix) (current user)" ?>
  <?elseif $(var.Scope) = perMachine ?>
    <?define ProductNameSuffix = "$(var.ChannelNameSuffix)" ?>
  <?else?>
    <?error Scope must be defined as either perMachine or perUser ?>
  <?endif?>

  <!-- Everything below is written in terms of these, so both channels stay in step. -->
  <?define ProductDisplayName = "$(var.AppName)$(var.ChannelNameSuffix)" ?>
  <?define InstallSubfolder = "$(var.AppInstallSubfolder)$(var.ChannelFolderSuffix)" ?>

  <Package
      Name="$(var.AppName)$(var.ProductNameSuffix)"
      Manufacturer="$(var.AppManufacturer)"
      Version="!(bind.fileVersion.MainExecutable)"
      UpgradeCode="$(var.UpgradeCodeGuid)"
      Scope="$(var.Scope)"
      Language="!(loc.ProductLanguage)"
      Compressed="yes">

    <SummaryInformation Description="!(loc.PackageDescription)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        AllowDowngrades="no"
        DowngradeErrorMessage="!(loc.DowngradeErrorMessage)"
        Schedule="afterInstallValidate" />

    <!--
      Windows Graphics Capture (LiveView) requires Windows 10 2004 / build 19041,
      matching TargetPlatformMinVersion in SQLBI.Whiteboard.csproj.
    -->
    <Launch
        Condition="Installed OR (VersionNT &gt;= 603 AND WINDOWSBUILDNUMBER &gt;= 19041)"
        Message="!(loc.SupportedWindowsVersionMessage)" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch
          Id="WindowsBuildNumberSearch"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber"
          Type="raw" />
    </Property>

    <Icon Id="AppIcon" SourceFile="$(var.PublishFolder)\$(var.AppExecutableName)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.AppUrlInfoAbout)" />
    <Property Id="ARPNOREPAIR" Value="yes" />

    <!-- Set DESKTOPSHORTCUT=0 on the command line to skip the desktop shortcut. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <Feature Id="Main" Title="$(var.ProductDisplayName)" Level="1">
      <ComponentGroupRef Id="ApplicationComponents" />
      <ComponentRef Id="ProgramMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsFolder)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsFolder)\banner.png" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsFolder)\background.png" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApplication)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MainExecutable]" />
    <CustomAction
        Id="LaunchApplication"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixShellExec"
        Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchApplication"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.Scope) = perUser ?>
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="AppManufacturerFolder" Name="$(var.AppInstallFolder)">
            <Directory Id="INSTALLFOLDER" Name="$(var.InstallSubfolder)" />
          </Directory>
        </Directory>
      </StandardDirectory>
    <?else?>
      <StandardDirectory Id="ProgramFiles6432Folder">
        <Directory Id="AppManufacturerFolder" Name="$(var.AppInstallFolder)">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallSubfolder)" />
        </Directory>
      </StandardDirectory>
    <?endif?>

    <ComponentGroup Id="ApplicationComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File
            Id="MainExecutable"
            Name="$(var.AppExecutableName)"
            Source="$(var.PublishFolder)\$(var.AppExecutableName)"
            Checksum="yes"
            KeyPath="yes" />
        <File
            Id="DocumentIcon"
            Name="SQLBI.Whiteboard.Document.ico"
            Source="$(var.PublishFolder)\SQLBI.Whiteboard.Document.ico" />

        <?if $(var.RegistersFileType) = "yes" ?>
          <!--
            Registers .wboard. MSI resolves the class root according to the package
            scope, so the same authoring serves both installers.
          -->
          <ProgId
              Id="$(var.BoardProgId)"
              Description="!(loc.BoardFileTypeDescription)"
              Icon="DocumentIcon">
            <Extension Id="$(var.BoardExtension)" ContentType="application/vnd.sqlbi.whiteboard">
              <Verb
                  Id="open"
                  Command="!(loc.BoardOpenVerb)"
                  TargetFile="MainExecutable"
                  Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        <?else?>
          <!--
            Read by AppChannel at startup to keep this channel's settings separate.
            Its absence is what identifies the released channel, so it ships only here.
          -->
          <File Id="ChannelMarker" Name="channel.txt" Source="$(var.AssetsFolder)\channel-$(var.Channel).txt" />
        <?endif?>
        <RegistryValue
            Root="HKMU"
            Key="Software\$(var.AppManufacturer)\$(var.InstallSubfolder)"
            Name="installFolder"
            Value="[INSTALLFOLDER]"
            Type="string" />
      </Component>

      <!--
        Harvests the rest of the publish output. Replaces the heat.exe pass and the
        XSLT filter used by the Bravo installer.
      -->
      <Files Include="$(var.PublishFolder)\**">
        <Exclude Files="$(var.PublishFolder)\$(var.AppExecutableName)" />
        <Exclude Files="$(var.PublishFolder)\SQLBI.Whiteboard.Document.ico" />
        <Exclude Files="$(var.PublishFolder)\**\*.pdb" />
        <Exclude Files="$(var.PublishFolder)\**\*.xml" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ProgramMenuShortcut">
        <Shortcut
            Id="ProgramMenuShortcut"
            Name="$(var.ProductDisplayName)"
            Description="!(loc.PackageDescription)"
            Target="[#MainExecutable]"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuShortcut" On="uninstall" />
        <RegistryValue
            Root="HKMU"
            Key="Software\$(var.AppManufacturer)\$(var.InstallSubfolder)"
            Name="programMenuShortcut"
            Value="1"
            Type="integer"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut
            Id="DesktopShortcut"
            Name="$(var.ProductDisplayName)"
            Description="!(loc.PackageDescription)"
            Target="[#MainExecutable]"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKMU"
            Key="Software\$(var.AppManufacturer)\$(var.InstallSubfolder)"
            Name="desktopShortcut"
            Value="1"
            Type="integer"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
